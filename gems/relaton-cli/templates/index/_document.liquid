<article class="document" data-id="{{ d.id | escape }}" data-title="{{ d.title | escape }}"{% if d.doctype %} data-doctype="{{ d.doctype | escape }}"{% endif %}{% if d.stage %} data-stage="{{ d.stage | escape }}"{% endif %}{% if d.date %} data-date="{{ d.date | escape }}"{% endif %}{% if d.yaml %} data-href="{{ d.yaml | escape }}"{% endif %}{% if d.link %} data-link="{{ d.link | escape }}"{% endif %} data-search="{{ d.id | append: ' ' | append: d.title | append: ' ' | append: d.doctype | downcase | escape }}">
  <h2 class="reference">{% if d.link %}<a href="{{ d.link | escape }}">{{ d.id | escape }}</a>{% else %}{{ d.id | escape }}{% endif %}</h2>
  <p class="doc-title">{{ d.title | escape }}</p>
  <div class="doc-meta">
    {%- if d.doctype %}<span class="doc-type">{{ d.doctype | escape }}</span>{% endif -%}
    {%- if d.stage %}<span class="doc-stage">{{ d.stage | escape }}</span>{% endif -%}
    {%- if d.date %}<time datetime="{{ d.date | escape }}">{{ d.date | escape }}</time>{% endif -%}
    {%- if d.yaml %}<a class="doc-yaml" href="{{ d.yaml | escape }}" target="_blank" rel="noopener">YAML</a>{% endif -%}
  </div>
</article>
