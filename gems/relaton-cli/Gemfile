source "https://rubygems.org"

# Specify your gem's dependencies in gemspec
gemspec

# The single combined `relaton` gem lives at the repo root.
gem "relaton", path: "../.."

# parsanol 1.3.111 is the trivia-exempt release (parsanol#355): the
# emission-2 artifacts (pubid#614) parse parameter-shaped under it, so
# the pin rides it; the root gemspec floor carries the same story.

# The pubid 2.0.0 FINAL gem still ships emission-1 artifacts - under
# 1.3.111 its parses break exactly as parsanol#352 describes. Both
# gemspecs floor pubid at 2.0.1, the first final release without that
# defect ("Unknown parameter type: colon" on a part+date docid).
#
# The PARG artifacts pubid ships are baked at the compiler the root
# bundle pins, and a newer runtime rejects the older artifact header
# (1.3.120 removed the pre-1.3.113 `mode` alias: "the grammar header
# keyword is edition"), so this bundle needs the same parsanol pin the
# root Gemfile carries — without it the floating 1.3.120 reddens every
# machine-index parse.
gem "parsanol", "1.3.114"
#
# TEMP: ride pubid's IHO series branch like the root bundle (pubid#635,
# relaton#407): it carries pubid main's `to_s(with_publisher:)` render
# contract (pubid#620, relaton#49) plus the IHO year/volume/issue identity
# components. CI rides pubid main until #635 merges: merge order is pubid#635
# first, then this. Return to a released pin with the root Gemfile.
gem "pubid", git: "https://github.com/pubid/pubid.git", branch: "fix/iho-series-year-volume"

# https://github.com/rails/rails/issues/55886
# add openssl as an explicit gem to fix SSL verification issues in GHA.
# gem "openssl"

# `canon` comes in through `lutaml-model`. Keep it below 0.3.52, as the root
# Gemfile does: from that version it installs `yeptris`, which replaces
# `Object#to_yaml` and raises `NameError` on Windows. See the root Gemfile.
gem "canon", "< 0.3.52"

gem "byebug", "~> 11.0"
gem "debug"
gem "equivalent-xml", "~> 0.6"
gem "fiddle"
gem "pry"
gem "rake"
