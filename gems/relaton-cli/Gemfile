gem "rspec-command", "~> 1.0.3"
gem "rspec-core", "~> 3.4"
gem "rspec-html", "~> 0.3.0"
gem "moxml", ">= 0.5.113" # lutaml/moxml#336: the formattedref add_child TypeError fixed in 0.5.113 (relaton#254)
gem "simplecov"
gem "vcr"
gem "webmock"
# leptris 1.9.386.0: the floor moxml's adapter names (older bindings load
# unusable and every XML path silently falls back to nokogiri), pinned to
# match the relaton root bundle — the battery re-run accompanies this bump.
gem "leptris", "1.9.391.0"

