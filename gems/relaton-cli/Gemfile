source "https://rubygems.org"

# Specify your gem's dependencies in gemspec
gemspec

# The single combined `relaton` gem lives at the repo root.
gem "relaton", path: "../.."

# parsanol 1.3.111 is the trivia-exempt release (parsanol#355): the
# emission-2 artifacts (pubid#614) parse parameter-shaped under it, so
# the pin rides it; the root gemspec floor carries the same story.

# The pubid 2.0.0 FINAL gem still ships emission-1 artifacts - under
# 1.3.111 its parses break exactly as parsanol#352 describes. The
# emission-2 set ships from 2.0.0.pre.alpha.64, so the pin names it;
# without it the resolver picks the final and every structured-corpus
# docid with a part+date fails ("Unknown parameter type: colon").
#
# TEMP: ride pubid main like the root bundle (pubid#620, relaton#49); it
# needs parsanol 1.3.114. Return to a released pin with the root Gemfile.
gem "pubid", git: "https://github.com/metanorma/pubid.git",
             ref: "fee1f7894bbae32022235d8de7e5ae7e67c972ec"
gem "parsanol", "1.3.114"

# https://github.com/rails/rails/issues/55886
# add openssl as an explicit gem to fix SSL verification issues in GHA.
# gem "openssl"

# `canon` comes in through `lutaml-model`. Keep it below 0.3.52, as the root
# Gemfile does: from that version it installs `yeptris`, which replaces
# `Object#to_yaml` and raises `NameError` on Windows. See the root Gemfile.
gem "canon", "< 0.3.52"

gem "byebug", "~> 11.0"
gem "debug"
gem "equivalent-xml", "~> 0.6"
gem "fiddle"
gem "pry"
gem "rake"
