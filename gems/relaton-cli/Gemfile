source "https://rubygems.org"

# Specify your gem's dependencies in gemspec
gemspec

# The single combined `relaton` gem lives at the repo root.
gem "relaton", path: "../.."

# parsanol 1.3.110 shipped the v2 named-tree dialect as the default: every
# uncaptured rule reference surfaces as a capture, so pubid parses plain
# references as per-atom lists ("ISO 8888" -> {number: "[{digit:..."}},
# "Unknown parameter type: space"). The v2 migration is pubid-side work in
# flight; pin the last classic-dialect release until it lands.
gem "parsanol", "1.3.109"

# https://github.com/rails/rails/issues/55886
# add openssl as an explicit gem to fix SSL verification issues in GHA.
# gem "openssl"

# `canon` comes in through `lutaml-model`. Keep it below 0.3.52, as the root
# Gemfile does: from that version it installs `yeptris`, which replaces
# `Object#to_yaml` and raises `NameError` on Windows. See the root Gemfile.
gem "canon", "< 0.3.52"

gem "byebug", "~> 11.0"
gem "debug"
gem "equivalent-xml", "~> 0.6"
gem "fiddle"
gem "pry"
gem "rake"
gem "rspec", "~> 3.0"
gem "rspec-command", "~> 1.0.3"
gem "rspec-core", "~> 3.4"
gem "rspec-html", "~> 0.3.0"
gem "moxml", ">= 0.5.113" # lutaml/moxml#336: the formattedref add_child TypeError fixed in 0.5.113 (relaton#254)
gem "simplecov"
gem "vcr"
gem "webmock"
# leptris 1.9.362.1 rebuilds the 362 line with the namespace-cache fix
# (leptris#1742), pinned to match the relaton root bundle — the battery
# re-run accompanies this bump.
gem "leptris", "1.9.370.1"
