source "https://rubygems.org"

# Specify your gem's dependencies in gemspec
gemspec

# The single combined `relaton` gem lives at the repo root.
gem "relaton", path: "../.."

# parsanol/pubid ride the gemspec floors (parsanol ~> 1.3.129 with pubid
# ~> 2.0.5): the 1.3.129 line fixes the renamed-binding OIML break and
# drops artifact edition 1 (relaton#439); pubid 2.0.5 re-bakes every
# artifact at edition 2 — the IHO component-model wave (relaton#440). No
# local pin — the joint-identifier regression on the 1.3.124 line is
# parsanol-ruby#409.
gem "pubid", "~> 2.0.5"

# https://github.com/rails/rails/issues/55886
# add openssl as an explicit gem to fix SSL verification issues in GHA.
# gem "openssl"

# canon rides the 0.3 line: on the current line (canon 0.3.122 /
# leptris 1.9.401 / yeptris 0.6.56.1) requiring canon no longer loads
# yeptris, `Object#to_yaml` stays owned by Object, and the `---` header
# round-trips — the "< 0.3.52" cap's premise is gone (verified 2026-11-03).
gem "canon", "~> 0.3"

