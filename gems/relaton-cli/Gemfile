gem "rspec-core", "~> 3.4"
gem "rspec-html", "~> 0.3.0"
gem "moxml", ">= 0.5.113" # lutaml/moxml#336: the formattedref add_child TypeError fixed in 0.5.113 (relaton#254)
gem "simplecov"
gem "vcr"
gem "webmock"
# VERIFIED 2026-10-16: leptris 1.9.366.0 + moxml 0.5.138 pass the full
# relaton-cli suite and match the relaton root bundle. 1.9.367 regresses
# the docidentifier serialization on CI linux (the "ik-l" separator
# divergence — leptris#1738 follow-up), so pin the exact verified line
# until the fix ships.
gem "leptris", "1.9.366.0"
