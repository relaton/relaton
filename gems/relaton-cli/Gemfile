gem "rspec-core", "~> 3.4"
gem "rspec-html", "~> 0.3.0"
gem "moxml", ">= 0.5.113" # lutaml/moxml#336: the formattedref add_child TypeError fixed in 0.5.113 (relaton#254)
gem "simplecov"
gem "vcr"
gem "webmock"
# leptris 1.9.362.1 rebuilds the 362 line with the namespace-cache fix
# (leptris#1742), pinned to match the relaton root bundle — the battery
# re-run accompanies this bump.
gem "leptris", "1.9.370.1"

