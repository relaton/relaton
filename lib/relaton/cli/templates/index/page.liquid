<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title | strip_html }}</title>
    {%- if description %}
    <meta name="description" content="{{ description | escape }}">
    {%- endif %}
    <meta name="generator" content="relaton-cli index">
    {%- if favicon %}
    <link rel="icon" href="{{ favicon | escape }}"{% if favicon_type %} type="{{ favicon_type }}"{% endif %}>
    {%- endif %}
    <style>{{ css }}</style>
  </head>
  <body>
    <div id="relaton-index-app" data-title="{{ title | escape }}" data-generated="{{ generated }}"{% if description %} data-description="{{ description | escape }}"{% endif %} data-total="{{ total }}" data-shards="{{ shards }}" data-shard-size="{{ shard_size }}" data-detail-shards="{{ detail_shards }}" data-detail-shard-size="{{ detail_shard_size }}"></div>
    <script>{{ iife }}</script>
  </body>
</html>
